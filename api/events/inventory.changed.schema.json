      ]
    },
    "eventType": {
      "type": "string",
      "enum": [
        "inventory.changed"
      ],
      "examples": [
        "inventory.changed"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ],
      "examples": [
        1
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "examples": [
        "2026-11-02T09:00:00Z"
      ]
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "examples": [
        "ad243c6d-9757-5fff-9a56-59d21e697bb6"
      ]
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid",
      "examples": [
